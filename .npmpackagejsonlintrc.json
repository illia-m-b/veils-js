{
  "rules": {
    "require-name": "error",
    "require-version": "error",
    "require-description": "error",
    "require-keywords": "error",
    "require-author": "error",
    "require-license": "error",
    "require-repository": "error",
    "require-homepage": "error",
    "require-bugs": "error",
    "require-engines": "error",
    "require-type": "error",
    "require-main": "error",
    "require-types": "error",
    "require-files": "error",
    "require-scripts": "error",
    "name-type": "error",
    "version-type": "error",
    "description-type": "error",
    "keywords-type": "error",
    "license-type": "error",
    "repository-type": "error",
    "homepage-type": "error",
    "engines-type": "error",
    "type-type": "error",
    "files-type": "error",
    "name-format": "error",
    "version-format": "error",
    "valid-values-license": ["error", ["MIT"]],
    "valid-values-type": ["error", ["module"]],
    "prefer-no-dependencies": "error",
    "prefer-no-engineStrict": "error",
    "prefer-absolute-version-devDependencies": "error",
    "prefer-alphabetical-devDependencies": "error",
    "prefer-alphabetical-scripts": "error",
    "no-duplicate-properties": "error",
    "prefer-provenance": "error",
    "no-archive-dependencies": "error",
    "no-archive-devDependencies": "error",
    "no-archive-peerDependencies": "error",
    "no-git-dependencies": "error",
    "no-git-devDependencies": "error",
    "no-git-peerDependencies": "error",
    "no-file-dependencies": "error",
    "no-file-devDependencies": "error",
    "no-file-peerDependencies": "error",
    "prefer-absolute-version-dependencies": "error",
    "prefer-absolute-version-peerDependencies": "error",
    "prefer-no-version-zero-dependencies": "error",
    "prefer-no-version-zero-devDependencies": [
      "error",
      {
        "exceptions": ["eslint-plugin-tsdoc", "@yegor256/dogent"]
      }
    ],
    "prefer-no-version-zero-peerDependencies": "error"
  }
}

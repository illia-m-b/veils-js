{
  "name": "veils-js",
  "version": "0.1.1",
  "description": "Veil Objects to replace DTOs, reduce boilerplate code, and leverage JavaScript's dynamic nature",
  "keywords": [
    "caching",
    "veil",
    "sql",
    "object-oriented-programming"
  ],
  "homepage": "https://github.com/illia-m-b/veils-js",
  "bugs": {
    "url": "https://github.com/illia-m-b/veils-js/issues",
    "email": "illiamb@duck.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illia-m-b/veils-js.git"
  },
  "license": "MIT",
  "author": {
    "name": "Illia Brashkin",
    "email": "illiamb@duck.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "format:code": "prettier --write --ignore-unknown .",
    "format:code:check": "prettier --check --ignore-unknown .",
    "format:pkg": "sort-package-json",
    "format:pkg:check": "sort-package-json --check",
    "lint:pkg": "npmPkgJsonLint --ignorePath .gitignore --maxWarnings 0 .",
    "lint:ts": "eslint --concurrency auto --max-warnings 0 .",
    "lint:ts:fix": "eslint --fix --concurrency auto .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.11.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "lefthook": "2.1.12",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-jsdoc": "1.8.1",
    "sort-package-json": "4.0.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "22.x || 24.x || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": "22.x || 24.x || >=26.0.0"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.27.7": true,
    "lefthook@2.1.12": true
  },
  "engine-strict": true
}

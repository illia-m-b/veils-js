{
  "name": "veils",
  "version": "0.0.0",
  "description": "Veil Objects: they cache all reads until the first write",
  "keywords": [
    "caching",
    "veil",
    "sql",
    "object-oriented-programming"
  ],
  "homepage": "https://github.com/illia-m-b/veils",
  "bugs": {
    "url": "https://github.com/illia-m-b/veils/issues",
    "email": "contact.line009@passinbox.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com:illia-m-b/veils.git"
  },
  "license": "MIT",
  "author": {
    "name": "Illia Brashkin",
    "email": "contact.line009@passinbox.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "format:code": "prettier -w .",
    "format:code:check": "prettier --no-color -c .",
    "format:pkg": "sort-package-json",
    "format:pkg:check": "sort-package-json -c",
    "lint:pkg": "npmPkgJsonLint .",
    "lint:ts": "eslint --no-color --concurrency='auto' --exit-on-fatal-error .",
    "lint:ts:fix": "eslint --fix .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.6",
    "sort-package-json": "4.0.0",
    "tsup": "8.5.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.68.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=22.0.0"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.27.7": true
  }
}
